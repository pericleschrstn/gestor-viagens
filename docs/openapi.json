  "info": {
    "title": "Gestor API",
    "description": "API para gestão de gastos em viagens",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ana Ribeiro"
          },
          "email": {
            "type": "string",
            "example": "ana@email.com"
          },
          "password": {
            "type": "string",
            "example": "senha123"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ana@email.com"
          },
          "password": {
            "type": "string",
            "example": "senha123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateTripDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Itália em família"
          },
          "initials": {
            "type": "string",
            "example": "IT"
          },
          "startDate": {
            "type": "string",
            "example": "2026-06-10"
          },
          "endDate": {
            "type": "string",
            "example": "2026-06-22"
          },
          "status": {
            "type": "string",
            "enum": [
              "planning",
              "active",
              "closed"
            ],
            "default": "planning"
          },
          "baseCurrency": {
            "type": "string",
            "enum": [
              "BRL",
              "ARS"
            ],
            "default": "BRL"
          },
          "totalBudget": {
            "type": "string",
            "example": "15000.00"
          }
        },
        "required": [
          "name",
          "initials",
          "startDate",
          "endDate"
        ]
      },
      "TripAccessDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "EDITOR",
              "VIEWER"
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "READ",
                "WRITE",
                "MANAGE_MEMBERS",
                "MANAGE_BUDGET",
                "DELETE_TRIP",
                "MANAGE_SETTLEMENTS"
              ]
            }
          }
        },
        "required": [
          "role",
          "permissions"
        ]
      },
      "UpdateTripDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Itália em família"
          },
          "initials": {
            "type": "string",
            "example": "IT"
          },
          "startDate": {
            "type": "string",
            "example": "2026-06-10"
          },
          "endDate": {
            "type": "string",
            "example": "2026-06-22"
          },
          "status": {
            "type": "string",
            "enum": [
              "planning",
              "active",
              "closed"
            ],
            "default": "planning"
          },
          "baseCurrency": {
            "type": "string",
            "enum": [
              "BRL",
              "ARS"
            ],
            "default": "BRL"
          },
          "totalBudget": {
            "type": "string",
            "example": "15000.00"
          }
        }
      },
      "CreateMemberDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ana"
          },
          "initials": {
            "type": "string",
            "example": "AN"
          },
          "userId": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "EDITOR",
              "VIEWER"
            ],
            "default": "EDITOR"
          }
        },
        "required": [
          "name",
          "initials"
        ]
      },
      "UpdateMemberDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ana"
          },
          "initials": {
            "type": "string",
            "example": "AN"
          },
          "userId": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "EDITOR",
              "VIEWER"
            ],
            "default": "EDITOR"
          }
        }
      },
      "ExpenseSplitDto": {
        "type": "object",
        "properties": {
          "memberId": {
            "type": "string"
          },
          "share": {
            "type": "string",
            "example": "50.00"
          }
        },
        "required": [
          "memberId",
          "share"
        ]
      },
      "CreateExpenseDto": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "example": "Jantar na trattoria"
          },
          "amount": {
            "type": "string",
            "example": "120.50"
          },
          "currency": {
            "type": "string",
            "enum": [
              "BRL",
              "ARS"
            ],
            "example": "ARS"
          },
          "date": {
            "type": "string",
            "example": "2026-06-14"
          },
          "category": {
            "type": "string",
            "enum": [
              "comida",
              "hospedagem",
              "transporte",
              "passeios",
              "compras",
              "outros"
            ]
          },
          "payerId": {
            "type": "string"
          },
          "receiptUrl": {
            "type": "string"
          },
          "splits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExpenseSplitDto"
            }
          }
        },
        "required": [
          "description",
          "amount",
          "currency",
          "date",
          "category",
          "payerId",
          "splits"
        ]
      },
      "UpdateExpenseDto": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "example": "Jantar na trattoria"
          },
          "amount": {
            "type": "string",
            "example": "120.50"
          },
          "currency": {
            "type": "string",
            "enum": [
              "BRL",
              "ARS"
            ],
            "example": "ARS"
          },
          "date": {
            "type": "string",
            "example": "2026-06-14"
          },
          "category": {
            "type": "string",
            "enum": [
              "comida",
              "hospedagem",
              "transporte",
              "passeios",
              "compras",
              "outros"
            ]
          },
          "payerId": {
            "type": "string"
          },
          "receiptUrl": {
            "type": "string"
          },
          "splits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExpenseSplitDto"
            }
          }
        }
      },
      "CategoryBudgetItemDto": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "comida",
              "hospedagem",
              "transporte",
              "passeios",
              "compras",
              "outros"
            ]
          },
          "limitAmount": {
            "type": "string",
            "example": "3000.00"
          }
        },
        "required": [
          "category",
          "limitAmount"
        ]
      },
      "UpdateBudgetDto": {
        "type": "object",
        "properties": {
          "totalBudget": {
            "type": "string",
            "example": "15000.00"
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryBudgetItemDto"
            }
          }
        },
        "required": [
          "categories"
